FROM ubuntu:24.04

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      build-essential \
      ca-certificates \
      ccache \
      clang \
      clang-format \
      clang-tidy \
      cmake \
      gcovr \
      git \
      ninja-build \
      shellcheck \
    && rm -rf /var/lib/apt/lists/*
